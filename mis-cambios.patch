+            s_turn.cart = true;
+            s_turn.cart_off = 0;
+            m.tts = TTS_ACTIVE;
+            s_turn.tts_msg = i;
+            s_turn.silent = false;
+            ESP_LOGI(TAG, "speaking message %s with Cartesia (%u chars)", m.id, (unsigned)m.len);
+            show_reply_start(m);
