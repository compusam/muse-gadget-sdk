index d768c99..a54b7cb 100644
--- a/esp32/components/muse/muse_settings.c
+++ b/esp32/components/muse/muse_settings.c
@@ -56,8 +56,8 @@ static struct {
     .volume = CONFIG_MUSE_DEFAULT_VOLUME,
     .speaker_on = true,
     .mic_gain = 30,
